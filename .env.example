# Copy to .env and fill in. Never commit .env (.gitignore already excludes it).

# ── Supabase — Project Settings > API ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key bypasses RLS. Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects GET /api/stats. Generate: openssl rand -hex 24
ADMIN_TOKEN=change-me

# ── Heisenberg (Nubia) combi-routing API ──
# Leave URL/KEY blank to use Nimbus's built-in local fallback scorer.
# To use the real engine, point to your Nubia deployment and share the SAME
# key you set as HEISENBERG_API_KEY in Nubia's .env.local.
HEISENBERG_API_URL=
HEISENBERG_API_KEY=
HEISENBERG_INSIGHT=false
HEISENBERG_TIMEOUT_MS=4000

# ── Pandora event ingestion ──
# Server-side only. Leave blank to disable Pandora locally.
PANDORA_SOURCE=nimbus
PANDORA_URL=https://your-pandora-ingestion.example
PANDORA_KEY=pk_nimbus_your_key
PANDORA_SECRET=your-pandora-hmac-secret

# ── Payments ──
# simulate = instant fake capture (demo). live = call real provider APIs.
PAYMENTS_MODE=simulate
# Where collected funds settle (your bank). Keep the real number out of git.
SETTLEMENT_BANK=Access Bank Botswana
SETTLEMENT_ACCOUNT_NAME=Nimbus
SETTLEMENT_ACCOUNT_NUMBER=your-access-bank-account-number
# Live-mode provider credentials (fill when your merchant accounts are ready):
# OM_CLIENT_ID=
# OM_CLIENT_SECRET=
# MYZAKA_MERCHANT_CODE=
# MYZAKA_API_KEY=
# SMEGA_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=

# ── Optional ──
PORT=3000
NODE_ENV=development
